{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Watermark Tool",
  "version": "../package.json",
  "identifier": "com.dwtwatermark.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "数字水印工具",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ikenxuan",
    "homepage": "https://github.com/ikenxuan/watermark",
    "copyright": "Copyright © 2026 ikenxuan",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "图片数字盲水印工具",
    "longDescription": "用于向图片嵌入和提取数字盲水印的桌面工具。",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
